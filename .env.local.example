# Mapbox token — required for map rendering
# Get yours at https://account.mapbox.com/  (free tier: 50k loads/month)
NEXT_PUBLIC_MAPBOX_TOKEN=

# Windy Webcams API key — optional, webcam layer returns empty without it
# Get yours at https://api.windy.com/  (free tier)
WINDY_API_KEY=

# Stormglass API key — optional, surf layer uses mock data without it
# Get yours at https://stormglass.io/  (free tier: 50 req/day)
STORMGLASS_API_KEY=
